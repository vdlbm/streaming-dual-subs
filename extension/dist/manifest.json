{
    "manifest_version": 3,
    "name": "Streaming Dual Subtitles",
    "version": "0.1.0",
    "description": "Display German and Spanish subtitles simultaneously on Netflix.",
    "permissions": [],
    "host_permissions": [
        "https://www.netflix.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://www.netflix.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "styles.css"
            ],
            "run_at": "document_idle"
        }
    ]
}